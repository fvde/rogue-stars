# .NET
artifacts/
*.user
.vs/
.idea/
# Unity
client/**/[Ll]ibrary/
client/**/[Tt]emp/
client/**/[Oo]bj/
client/**/[Bb]uild/
client/**/[Bb]uilds/
client/**/[Ll]ogs/
client/**/[Uu]ser[Ss]ettings/
client/**/*.csproj
client/**/*.sln
client/**/.utmp/
client/**/[Ss]creenshots/
# Terraform
infra/**/.terraform/
infra/**/*.tfstate*
infra/**/*.tfvars
!infra/**/example.tfvars
# OS
.DS_Store

# Unity regenerates these for the shared package; it holds no assets referenced by GUID
shared/**/*.meta
# Agent worktrees
.claude/
# Firebase emulator logs
firebase-debug.log
firestore-debug.log
*-debug.log

# Firebase client config (per environment; injected locally, never committed)
client/RogueStars/Assets/google-services.json
client/RogueStars/Assets/google-services.json.meta
# Firebase Android resources generated from google-services.json by the Firebase editor tooling
client/RogueStars/Assets/Plugins/Android/FirebaseApp.androidlib/
client/RogueStars/Assets/Plugins/Android/FirebaseApp.androidlib.meta
# Google Unity packages fetched by scripts/fetch-unity-packages.sh (Firebase App alone is ~60 MB)
client/RogueStars/Packages/google/
# Release upload keystores never live in the repository
*.jks
*.keystore
# Desktop copy of google-services.json generated by the Firebase editor tooling
client/RogueStars/Assets/StreamingAssets/google-services-desktop.json
client/RogueStars/Assets/StreamingAssets/google-services-desktop.json.meta
client/RogueStars/Assets/StreamingAssets.meta
# Local Maven repos copied out of the Firebase packages by External Dependency Manager on every resolve
client/RogueStars/Assets/GeneratedLocalRepo/
client/RogueStars/Assets/GeneratedLocalRepo.meta
# Written by the Play Games plugin upgrader on every editor load (empty APP_ID) and by BuildSecrets per build
client/RogueStars/Assets/Plugins/Android/GooglePlayGamesManifest.androidlib/
client/RogueStars/Assets/Plugins/Android/GooglePlayGamesManifest.androidlib.meta

# Unity Test Framework leftovers
client/RogueStars/Assets/InitTestScene*
__pycache__/
