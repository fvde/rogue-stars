<Project Sdk="Microsoft.NET.Sdk">
  <!-- Meta-progression simulator: bots play the real rules engine for years of game time (docs/balance). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>RogueStars.Sim</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\shared\RogueStars.Rules\RogueStars.Rules.csproj" />
  </ItemGroup>
</Project>
