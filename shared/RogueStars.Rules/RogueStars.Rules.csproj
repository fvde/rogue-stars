<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared game rules. Must stay Unity-compatible: netstandard2.1, C# 9, no external dependencies. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>RogueStars.Rules</RootNamespace>
  </PropertyGroup>
</Project>
