<linker>
  <!-- State/command/DTO classes are created by Newtonsoft via reflection: keep them whole under IL2CPP stripping. -->
  <assembly fullname="RogueStars.Rules" preserve="all" />
  <assembly fullname="RogueStars.Client" preserve="all" />
  <!-- Firebase Auth: SWIG callbacks from the native SDK are reached by reflection/P/Invoke. -->
  <assembly fullname="Firebase.App" preserve="all" />
  <assembly fullname="Firebase.Auth" preserve="all" />
  <assembly fullname="Firebase.Platform" preserve="all" />
  <assembly fullname="Firebase.TaskExtension" preserve="all" />
  <!-- Google Play Games plugin: Java callbacks (AndroidJavaProxy) are resolved by name. -->
  <assembly fullname="Google.Play.Games" preserve="all" />
</linker>
